# Email provider: `cloudflare_temp_email` or `cloudmail`
EMAIL_PROVIDER=cloudflare_temp_email

# Cloudflare Temp Email
CLOUDFLARE_TEMP_EMAIL_API_BASE=https://your-worker.workers.dev
CLOUDFLARE_TEMP_EMAIL_ADMIN_PASSWORD=
CLOUDFLARE_TEMP_EMAIL_DOMAINS=mail.example.com
CLOUDFLARE_TEMP_EMAIL_PROXY=

# CloudMail
CLOUDMAIL_BASE_URL=https://example.com/api
CLOUDMAIL_EMAIL=admin@example.com
CLOUDMAIL_PASSWORD=your_password
CLOUDMAIL_DOMAIN=@example.com

# 邀请成员角色：standard-user（普通成员）/ account-admin（管理员）
TEAM_INVITE_ROLE=account-admin

# CPA (CLIProxyAPI)
CPA_URL=http://127.0.0.1:8317
CPA_KEY=
CPA_SYNC_ENABLED=true

# API 鉴权（不设置则不启用，任何人都可访问）
API_KEY=

# Playwright 无头模式（true/false）
PLAYWRIGHT_HEADLESS=false

# Playwright 浏览器代理（可选）
# 示例：socks5://host.docker.internal:1080
# 注意：Playwright/Chromium 不支持带认证的 socks5（如 socks5://user:pass@host:port）
PLAYWRIGHT_PROXY_URL=
# 示例：localhost,127.0.0.1
PLAYWRIGHT_PROXY_BYPASS=

# 管理员 session_token 导入后端：uc（SeleniumBase UC）/ playwright
CHATGPT_SESSION_IMPORT_BACKEND=uc
SELENIUMBASE_UC_RECONNECT_TIME=6

# 轮询配置
EMAIL_POLL_INTERVAL=3
EMAIL_POLL_TIMEOUT=300

# 自动巡检（API 模式下生效）
AUTO_CHECK_INTERVAL=300      # 巡检间隔（秒），默认 5 分钟
AUTO_CHECK_THRESHOLD=10      # 额度低于此百分比触发轮转，默认 10%
AUTO_CHECK_MIN_LOW=2         # 至少几个账号低于阈值才触发，默认 2
